# This diag_table contains MOM5 output diagnostics for the OMIP6
# ACCESS-OM2 (OMIP Version 2 - JRA55 reanalysis forced simulation)
# submission.
#
# The OMIP protocol is described in the following paper:
#
# Griffies et al. (2016) OMIP contribution to CMIP6: experimental and
# diagnostic protocol for the physical component of the Ocean Model
# Intercomparison Project, Geosci. Model Dev., 9, 3231-3296.

# output files
"ocean_grid",                 -1,  "months", 1, "days", "time",
"ocean_daily",                24,  "hours",  1, "days", "time",
"ocean_scalar_snapshot",      24,  "hours",  1, "days", "time",
"ocean_month",                 1,  "months", 1, "days", "time",
"ocean_scalar",                1,  "months", 1, "days", "time",
"ocean_budget",                1,  "months", 1, "days", "time",
"ocean_budget_daily",         24,  "hours",  1, "days", "time",
"ocean_budget_daily_risavg",  24,  "hours",  1, "days", "time",
"ocean_snapshot",              1,  "months", 1, "days", "time",
"ocean_snapshot_daily",       24,  "hours",  1, "days", "time"

# RMH: ocean_budget contains priority 3 variables like 3D heat/salt budgets, diffusivities etc.
# These are only requested at annual resolution. They will be output at monthly resolution over the
# last cycle.

